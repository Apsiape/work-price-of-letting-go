import Lake
open Lake DSL

package scheduleLaw where
  moreLeanArgs := #["-j1", "-M6144"]
  -- The shipped replay.py supplies both options to every source compile.
  leanOptions := #[⟨`maxRecDepth, .ofNat 100000⟩, ⟨`maxSynthPendingDepth, .ofNat 10000⟩]

require mathlib from git "https://github.com/leanprover-community/mathlib4" @
  "c5ea00351c28e24afc9f0f84379aa41082b1188f"

@[default_target]
lean_lib QuantumInfo where
  srcDir := "vendor/PhyslibQuantumInfo"
  roots := #[`QuantumInfo.Entropy.SSA, `QuantumInfo.Entropy.Relative, `QuantumInfo.Entropy.DPI]
  globs := #[.submodules `QuantumInfo]
  -- Match replay.py's vendor-only compiler settings.
  leanOptions := #[⟨`backward.isDefEq.respectTransparency, false⟩,
    ⟨`linter.unusedSimpArgs, false⟩, ⟨`synthInstance.maxHeartbeats, .ofNat 200000⟩,
    ⟨`maxHeartbeats, .ofNat 2000000⟩]

